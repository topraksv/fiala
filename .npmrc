# This SDK's tooling breaks silently on Node 24/26 (native TS stripping),
# measured here rather than published by Expo — which states a 22.13.x
# minimum and no maximum. `engines` in package.json is the range; this
# makes npm enforce it instead of only documenting it.
engine-strict=true
# A seven-day quarantine for newly published versions. `min-release-age`
# arrived in npm 11.10, and the npm Node 22 ships (10.9) ignores the key without
# a word. This machine's Node 22 carries npm 11.19 since 2026-09-25, measured:
# `npm i typescript@next` resolved the same-day 7.1 dev build under npm 10 and
# 7.0.2 under npm 11. CI keeps the bundled 10.9, which only runs `npm ci` and
# resolves nothing; the one tree resolved beside a credential pins its own
# date: `deploy-mobile` in `.github/workflows/ci.yml`. A `brew upgrade node@22`
# restores the bundled npm, and `npm --version` says so.
min-release-age=7
