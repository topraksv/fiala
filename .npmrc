# This SDK's tooling breaks silently on Node 24/26 (native TS stripping),
# measured here rather than published by Expo — which states a 22.13.x
# minimum and no maximum. `engines` in package.json is the range; this
# makes npm enforce it instead of only documenting it.
engine-strict=true
# No release-age wait: a version installs the day it ships unless an advisory
# names it, and `scripts/check-advisories.mjs` fails on any published fix.
