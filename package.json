    "node": "^22"
  },
  "dependencies": {
    "@supabase/realtime-js": "^2.117.2",
    "@supabase/supabase-js": "^2.117.2",
    "babel-preset-expo": "~58.0.0",
    "drizzle-orm": "^0.45.3",
    "expo": "~58.0.17",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "fflate": "^0.8.3",
    "lucide-react-native": "^1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "uuidv7": "^1.2.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.2",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "5.0.5"
  },
  "scripts": {
    "postinstall": "node scripts/patch-dependencies.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "echo \"Expo's web dev server cannot bundle this app; serving the export instead. Re-run after a change.\" && npm run web:preview",
    "lint": "expo lint",
    "lint:ratchet": "node scripts/check-lint-ratchet.mjs",
    "lint:record": "node scripts/check-lint-ratchet.mjs --record",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "verify": "npm run typecheck && npm run test:coverage && npm run lint:ratchet",
    "web:export": "expo export -p web --clear",
    "web:preview": "npm run web:export && node scripts/serve-web-export.mjs dist 4598",
    "bundle:check": "node scripts/check-web-budget.mjs dist --require-supabase-config",
    "verify:full": "npm run verify && npm run web:export && npm run bundle:check && npm run test:e2e",
    "test:e2e:export": "node scripts/export-e2e-web.mjs",
    "test:e2e": "npm run test:e2e:export && playwright test",
    "test:mutation": "stryker run && node scripts/check-mutation-ratchet.mjs",
    "test:mutation:ci": "stryker run stryker.ci.config.mjs && node scripts/check-mutation-ratchet.mjs",
    "mutation:record": "node scripts/check-mutation-ratchet.mjs --record",
    "audit:unused": "npx --yes knip@6.32.0",
    "audit:duplication": "npx --yes jscpd@5.0.16 src",
    "db:generate": "drizzle-kit generate"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "^4.6.6"
    },
    "xcode": {
      "uuid": "^11.1.1"
    },
    "decode-uri-component": "^0.5.0",
    "esbuild": "^0.25.12",
    "typed-rest-client": {
      "qs": "^6.16.0"
    }
  }
}
